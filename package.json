{
  "name": "tournamate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --pretty false",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:local": "node scripts/run-playwright-local.mjs",
    "test:e2e:ui": "playwright test --ui",
    "qa:seed": "node scripts/qa-seed.mjs",
    "qa:cleanup": "node scripts/qa-cleanup.mjs",
    "qa:reset": "npm run qa:cleanup && npm run qa:seed",
    "qa:check": "npm run typecheck && npm run lint && npm run test:unit && npm run test:e2e",
    "qa": "npm run qa:seed && npm run qa:check && npm run qa:cleanup"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "html2canvas-pro": "^2.0.2",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "next": "16.2.3",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
