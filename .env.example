NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required by QA seed/cleanup scripts. Never expose this client-side.
SUPABASE_SERVICE_ROLE_KEY=

# Safety guard for QA seed/cleanup against hosted Supabase projects.
# Set to 1 only for a dedicated development/staging QA database.
QA_ALLOW_REMOTE=
QA_TOURNAMENT_SLUG=qa-smoke-tournament
QA_ADMIN_EMAIL=qa-admin@tournamate.test
QA_ADMIN_PASSWORD=

# Optional: used by local/E2E tests to log in as a real approved admin user.
# Do not prefix these with NEXT_PUBLIC_.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
